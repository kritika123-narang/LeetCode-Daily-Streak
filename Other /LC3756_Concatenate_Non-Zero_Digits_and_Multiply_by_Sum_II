import java.util.*;

class Solution {

    static final long MOD = 1000000007L;

    public int[] sumAndMultiply(String s, int[][] queries) {

        int n = s.length();

        long[] prefix = new long[n];
        long[] digitSum = new long[n];
        int[] count = new int[n];

        long value = 0;
        long sum = 0;
        int cnt = 0;


        for(int i = 0; i < n; i++) {

            int digit = s.charAt(i)-'0';

            if(digit != 0) {

                value = (value * 10 + digit) % MOD;

                sum += digit;

                cnt++;
            }

            prefix[i] = value;
            digitSum[i] = sum;
            count[i] = cnt;
        }


        // powers of 10
        long[] pow10 = new long[cnt + 1];

        pow10[0] = 1;

        for(int i=1;i<=cnt;i++) {

            pow10[i] = (pow10[i-1]*10)%MOD;
        }


        int[] ans = new int[queries.length];


        for(int q=0;q<queries.length;q++) {

            int l = queries[q][0];
            int r = queries[q][1];


            long x;

            int digitsBefore = l==0 ? 0 : count[l-1];

            int digitsAfter = count[r];

            int len = digitsAfter - digitsBefore;


            long leftValue = l==0 ? 0 : prefix[l-1];


            x = (prefix[r] -
                    (leftValue * pow10[len])%MOD
                + MOD)%MOD;


            long sumValue =
                    digitSum[r] -
                    (l==0 ? 0 : digitSum[l-1]);


            ans[q] =
                (int)((x * sumValue)%MOD);
        }


        return ans;
    }
}


