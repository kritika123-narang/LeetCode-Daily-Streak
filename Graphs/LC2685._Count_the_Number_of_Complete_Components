import java.util.*;

class Solution {

    public int countCompleteComponents(int n, int[][] edges) {

        List<List<Integer>> adj = new ArrayList<>();

        for(int i = 0; i < n; i++) {
            adj.add(new ArrayList<>());
        }


        // Build graph
        for(int[] edge : edges) {

            int u = edge[0];
            int v = edge[1];

            adj.get(u).add(v);
            adj.get(v).add(u);
        }


        boolean[] vis = new boolean[n];

        int ans = 0;


        for(int i = 0; i < n; i++) {

            if(!vis[i]) {

                int[] result = dfs(i, adj, vis);

                int nodes = result[0];
                int edgesCount = result[1] / 2;


                if(edgesCount == nodes * (nodes - 1) / 2) {
                    ans++;
                }
            }
        }


        return ans;
    }



    private int[] dfs(int node,
                      List<List<Integer>> adj,
                      boolean[] vis) {


        vis[node] = true;

        int nodes = 1;
        int edges = adj.get(node).size();


        for(int neighbour : adj.get(node)) {

            if(!vis[neighbour]) {

                int[] res = dfs(neighbour, adj, vis);

                nodes += res[0];
                edges += res[1];
            }
        }


        return new int[]{nodes, edges};
    }
}
